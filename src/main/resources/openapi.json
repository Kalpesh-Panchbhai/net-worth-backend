{
  "openapi": "3.0.3",
  "info": {
    "title": "Net Worth Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "users",
      "description": "User management"
    },
    {
      "name": "income-tags",
      "description": "Income tag management"
    },
    {
      "name": "income-sources",
      "description": "Income source management"
    },
    {
      "name": "incomes",
      "description": "Income management"
    },
    {
      "name": "watchlists",
      "description": "Watchlist management"
    }
  ],
  "paths": {
    "/incomes": {
      "post": {
        "tags": [
          "incomes"
        ],
        "summary": "Create an income (UTC)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncomeRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "userId": 1,
                    "incomeSourceId": 10,
                    "incomeTagId": 5,
                    "netAmount": 1000.5,
                    "taxPaid": 100.25,
                    "currency": "INR",
                    "creditedDate": "2025-08-26T09:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Income created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncome"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/income-sources": {
      "post": {
        "tags": [
          "income-sources"
        ],
        "summary": "Create an income source",
        "description": "Creates an income source. If `default` is true, any existing default source for the same user will be unset so that only one source is default per user (application-level enforcement).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncomeSourceRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "userId": 1,
                    "name": "Company",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Income source created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncomeSource"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/income-tags": {
      "post": {
        "tags": [
          "income-tags"
        ],
        "summary": "Create an income tag",
        "description": "Creates an income tag. If `default` is true, any existing default tag for the same user will be unset so that only one tag is default per user (application-level enforcement).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIncomeTagRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "userId": 1,
                    "name": "Salary",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Income tag created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncomeTag"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/users": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create or ensure a user exists",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "externalUserId": "demo-user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          },
          "200": {
            "description": "User ensured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/users/{id}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Delete a user by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/income-tags/{id}": {
      "get": {
        "tags": [
          "income-tags"
        ],
        "summary": "List income tags for a user by internal user id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal user id (users.id)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of income tags",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncomeTagList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "income-tags"
        ],
        "summary": "Set an income tag as default by tag id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Income tag id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Default set"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/income-sources/{id}": {
      "get": {
        "tags": [
          "income-sources"
        ],
        "summary": "List income sources for a user by internal user id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal user id (users.id)",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of income sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncomeSourceList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "income-sources"
        ],
        "summary": "Set an income source as default by source id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Income source id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Default set"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/incomes/{id}": {
      "get": {
        "tags": [
          "incomes"
        ],
        "summary": "List incomes for a user by internal user id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Internal user id (users.id)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of incomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncomeList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "incomes"
        ],
        "summary": "Update an income by id (partial)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Income id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIncomeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Income updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseIncome"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "delete": {
        "tags": [
          "incomes"
        ],
        "summary": "Delete an income by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/watchlists": {
      "post": {
        "tags": [
          "watchlists"
        ],
        "summary": "Create a watchlist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateWatchlistRequest" },
              "examples": {
                "default": {
                  "value": { "userId": 1, "name": "My Watchlist" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Watchlist created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseWatchlist" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Conflict" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/watchlists/{id}": {
      "get": {
        "tags": [ "watchlists" ],
        "summary": "List watchlists for a user by internal user id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal user id (users.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of watchlists with current/previous day values and invested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseWatchlistSummaryList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "patch": {
        "tags": [ "watchlists" ],
        "summary": "Update a watchlist name by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Watchlist id",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateWatchlistNameRequest" },
              "examples": { "default": { "value": { "name": "Updated Name" } } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Watchlist updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseWatchlist" } } }
          },
          "409": { "$ref": "#/components/responses/Conflict" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "delete": {
        "tags": [ "watchlists" ],
        "summary": "Delete a watchlist by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseUser": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "externalUserId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "externalUserId"
        ]
      },
      "CreateIncomeTagRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "name"
        ]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "externalUserId": {
            "type": "string"
          }
        },
        "required": [
          "externalUserId"
        ]
      },
      "IncomeTag": {
        "type": "object",
        "description": "Income tag for a user. Only one tag per user can have `default=true`.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "default"
        ]
      },
      "ApiResponseIncomeTag": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/IncomeTag"
          }
        }
      },
      "ApiResponseIncomeTagList": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncomeTag"
            }
          }
        }
      },
      "ApiResponseIncomeSource": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/IncomeSource"
          }
        }
      },
      "ApiResponseIncomeSourceList": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncomeSource"
            }
          }
        }
      },
      "IncomeSource": {
        "type": "object",
        "description": "Income source for a user. Only one source per user can have `default=true`.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "default"
        ]
      },
      "CreateIncomeSourceRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "name"
        ]
      },
      "Income": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "incomeSourceId": {
            "type": "integer",
            "format": "int64"
          },
          "incomeTagId": {
            "type": "integer",
            "format": "int64"
          },
          "netAmount": {
            "type": "number"
          },
          "taxPaid": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "creditedDate": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601"
          }
        },
        "required": [
          "id",
          "userId",
          "incomeSourceId",
          "incomeTagId",
          "netAmount",
          "taxPaid",
          "currency",
          "creditedDate"
        ]
      },
      "CreateIncomeRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "incomeSourceId": {
            "type": "integer",
            "format": "int64"
          },
          "incomeTagId": {
            "type": "integer",
            "format": "int64"
          },
          "netAmount": {
            "type": "number"
          },
          "taxPaid": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "creditedDate": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO 8601"
          }
        },
        "required": [
          "userId",
          "incomeSourceId",
          "incomeTagId",
          "netAmount",
          "currency",
          "creditedDate"
        ]
      },
      "UpdateIncomeRequest": {
        "type": "object",
        "description": "Provide any subset of fields to update. At least one field is required.",
        "properties": {
          "incomeSourceId": { "type": "integer", "format": "int64" },
          "incomeTagId": { "type": "integer", "format": "int64" },
          "netAmount": { "type": "number" },
          "taxPaid": { "type": "number" },
          "currency": { "type": "string" },
          "creditedDate": { "type": "string", "format": "date-time", "description": "UTC ISO 8601" }
        }
      },
      "ApiResponseIncome": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/Income"
          }
        }
      },
      "ApiResponseIncomeList": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Income"
            }
          }
        }
      },
      "Watchlist": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        },
        "required": [ "id", "userId", "name" ]
      },
      "ApiResponseWatchlist": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/Watchlist" }
        }
      },
      "WatchlistSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "currentDayValue": { "type": "number" },
          "previousDayValue": { "type": "number" },
          "invested": { "type": "number" }
        },
        "required": [ "id", "userId", "name", "currentDayValue", "previousDayValue", "invested" ]
      },
      "ApiResponseWatchlistSummaryList": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WatchlistSummary" }
          }
        }
      },
      "CreateWatchlistRequest": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        },
        "required": [ "userId", "name" ]
      },
      "UpdateWatchlistNameRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": [ "name" ]
      },
      "ApiError": {
        "type": "object",
