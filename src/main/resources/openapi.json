{
  "openapi": "3.0.3",
  "info": {
    "title": "Net Worth Backend API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "tags": [
    { "name": "users", "description": "User management" },
    { "name": "income-tags", "description": "Income tag management" }
  ],
  "paths": {
    "/income-tags": {
      "post": {
        "tags": ["income-tags"],
        "summary": "Create an income tag",
        "description": "Creates an income tag. If `default` is true, any existing default tag for the same user will be unset so that only one tag is default per user (application-level enforcement).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateIncomeTagRequest" },
              "examples": {
                "default": {
                  "value": { "userId": 1, "name": "Salary", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Income tag created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseIncomeTag" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Conflict" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/users": {
      "post": {
        "tags": ["users"],
        "summary": "Create or ensure a user exists",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "examples": {
                "default": {
                  "value": { "userId": "demo-user" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          },
          "200": {
            "description": "User ensured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/users/{id}": {
      "delete": {
        "tags": ["users"],
        "summary": "Delete a user by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": { "description": "User deleted" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/income-tags/{id}": {
      "get": {
        "tags": ["income-tags"],
        "summary": "List income tags for a user by internal user id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Internal user id (users.id)",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of income tags",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseIncomeTagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseUser": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "userId": { "type": "string" }
        },
        "required": ["id", "userId"]
      },
      "CreateIncomeTagRequest": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "default": { "type": "boolean" }
        },
        "required": ["userId", "name"]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" }
        },
        "required": ["userId"]
      },
      "IncomeTag": {
        "type": "object",
        "description": "Income tag for a user. Only one tag per user can have `default=true`.",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "default": { "type": "boolean" }
        },
        "required": ["id", "userId", "name", "default"]
      },
      "ApiResponseIncomeTag": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/IncomeTag" }
        }
      },
      "ApiResponseIncomeTagList": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/IncomeTag" }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    }
  }
}
